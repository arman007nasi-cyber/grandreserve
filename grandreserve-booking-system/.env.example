# --- Database ---
DATABASE_URL=postgresql+asyncpg://booking_user:booking_pass@db:5432/booking_db
# Used only by the backup script (plain psql connection, not asyncpg)
DATABASE_URL_SYNC=postgresql://booking_user:booking_pass@db:5432/booking_db

# --- Redis (locking, pub/sub for websockets, rate limiting) ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Support contact shown in the API docs / footer ---
SUPPORT_EMAIL=support-x7q2f9@grandreserve-demo.com

# --- Reservation rules ---
RESERVATION_HOLD_SECONDS=120
